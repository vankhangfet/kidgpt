# LLM endpoint chuẩn OpenAI-compatible (bắt buộc)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Firebase (bắt buộc khi bật login) — đặt các biến này trên Vercel dashboard;
# route /api/firebase-config sẽ sinh config cho frontend từ env.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
# Tùy chọn — mặc định suy thành "<PROJECT_ID>.firebaseapp.com"
FIREBASE_AUTH_DOMAIN=

# Tham số bổ sung ghép vào request body (JSON, tùy chọn)
# Ví dụ tắt thinking của GLM trên z.ai để phản hồi nhanh hơn 2-3 lần:
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
LLM_EXTRA_BODY=

# Rate limit production (tùy chọn — thiếu thì bỏ qua rate limit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
